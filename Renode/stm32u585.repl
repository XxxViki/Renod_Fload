sysbus:
    init:
        Tag <0x70000000 0x10000000> "octospi2"
        Tag <0x90000000 0x10000000> "octospi1"
        Tag <0x42040000 0x80000> "usbotg_fs"
        Tag <0x8078000 0x69000> "slot1_partition"
        Tag <0x8010000 0x68000> "slot0_partition"
        Tag <0x8000000 0x10000> "boot_partition"
        Tag <0x80f0000 0x10000> "storage_partition"
        Tag <0x42020000 0x2800> "pinctrl"
        Tag <0xbfa0500 0x1b00> "flash@bfa0500"
        Tag <0x40002c00 0x1000> "wwdg / spi2"
        Tag <0x40036400 0x800> "backup_sram"
        Tag <0x40000000 0x400> "timers2"
        Tag <0x40000c00 0x400> "timers5"
        Tag <0x40001000 0x400> "timers6"
        Tag <0x40001400 0x400> "timers7"
        Tag <0x40004400 0x400> "usart2"
        Tag <0x40005000 0x400> "uart5"
        Tag <0x40008400 0x400> "i2c4"
        Tag <0x40009400 0x400> "lptim2"
        Tag <0x4000a400 0x400> "fdcan1"
        Tag <0x4000dc00 0x400> "ucpd1"
        Tag <0x40012c00 0x400> "timers1"
        Tag <0x40013400 0x400> "timers8"
        Tag <0x40014000 0x400> "timers15"
        Tag <0x40014400 0x400> "timers16"
        Tag <0x40014800 0x400> "timers17"
        Tag <0x40015400 0x400> "sai1 / sai1_a / sai1_b"
        Tag <0x40020000 0x400> "gpdma1"
        Tag <0x40022000 0x400> "flash"
        Tag <0x40023000 0x400> "crc"
        Tag <0x420c0000 0x400> "aes"
        Tag <0x420c0400 0x400> "hash"
        Tag <0x420c8000 0x400> "sdmmc1"
        Tag <0x420c8c00 0x400> "sdmmc2"
        Tag <0x420d0400 0x400> "fmc"
        Tag <0x420d1400 0x400> "octospi1"
        Tag <0x420d2400 0x400> "octospi2"
        Tag <0x46002000 0x400> "spi3"
        Tag <0x46002400 0x400> "lpuart1"
        Tag <0x46002800 0x400> "i2c3"
        Tag <0x46004400 0x400> "lptim1"
        Tag <0x46004800 0x400> "lptim3"
        Tag <0x46004c00 0x400> "lptim4"
        Tag <0x46007400 0x400> "vrefbuf"
        Tag <0x46021800 0x400> "dac1"
        Tag <0x46022000 0x400> "exti"
        Tag <0x4000ac00 0x350> "fdcan1"
        Tag <0xbfa0000 0x200> "st_nvm_user_otp"
        Tag <0xe000ed90 0x40> "mpu"
        Tag <0xe000e010 0x10> "systick"
        Tag <0x210 0x2> "ts_cal1_otp"
        Tag <0x242 0x2> "ts_cal2_otp"
        Tag <0x2a5 0x2> "vrefint_otp"

timers3: Timers.STM32_Timer @ sysbus <0x40000400, +0x400>
    frequency: 10000000
    initialLimit: 0xffffffff
    ->nvic0@46

timers4: Timers.STM32_Timer @ sysbus <0x40000800, +0x400>
    frequency: 10000000
    initialLimit: 0xffffffff
    ->nvic0@47

gpioa: GPIOPort.STM32_GPIOPort @ sysbus <0x42020000, +0x400>

gpiob: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>

gpioc: GPIOPort.STM32_GPIOPort @ sysbus <0x42020800, +0x400>

gpiod: GPIOPort.STM32_GPIOPort @ sysbus <0x42020c00, +0x400>

gpioe: GPIOPort.STM32_GPIOPort @ sysbus <0x42021000, +0x400>

gpiof: GPIOPort.STM32_GPIOPort @ sysbus <0x42021400, +0x400>

gpiog: GPIOPort.STM32_GPIOPort @ sysbus <0x42021800, +0x400>

gpioh: GPIOPort.STM32_GPIOPort @ sysbus <0x42021c00, +0x400>

gpioi: GPIOPort.STM32_GPIOPort @ sysbus <0x42022000, +0x400>

partition: Memory.MappedMemory @ sysbus 0x0
    size: 0x4000000

flash0: Memory.MappedMemory @ sysbus 0x8000000
    size: 0x200000

sram0: Memory.MappedMemory @ sysbus 0x20000000
    size: 0xc0000

sram1: Memory.MappedMemory @ sysbus 0x28000000
    size: 0x4000

extflash_octonor: Memory.MappedMemory @ sysbus 0x70000000
    size: 0x4000000

psram: Memory.MappedMemory @ sysbus 0x90000000
    size: 0x800000

// autogenerated

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0
    systickFrequency: 160000000

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic0

greenled1: Miscellaneous.LED @ gpioh 0x7
    invert: true

gpioh:
    7 -> greenled1@0

redled1: Miscellaneous.LED @ gpioh 0x6
    invert: true

gpioh:
    6 -> redled1@0

i2c2: I2C.STM32F7_I2C @ sysbus 0x40005800
    EventInterrupt->nvic0@57
    ErrorInterrupt->nvic0@58

veml6030: Sensors.VEML7700 @ i2c2 0x10

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 32000

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 200000000
    IRQ->nvic0@63

uart4: UART.STM32F7_USART @ sysbus 0x40004c00
    frequency: 200000000
    IRQ->nvic0@64

i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
    EventInterrupt->nvic0@55
    ErrorInterrupt->nvic0@56

spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.F4
    IRQ->nvic0@59

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 200000000
    IRQ->nvic0@61

adc1: Analog.STM32_ADC @ sysbus 0x42028000
    IRQ->nvic0@37

rng: Miscellaneous.STM32_RNG @ sysbus 0x420c0800
    series: STM32Series.F4
    ->nvic0@94

rtc: Timers.STM32F4_RTC @ sysbus 0x46007800
    AlarmIRQ->nvic0@2

pwr: Python.PythonPeripheral @ sysbus 0x46020800
    size: 0x400
    initable: true
    filename: "scripts/pydev/flipflop.py"

rcc: Python.PythonPeripheral @ sysbus 0x46020c00
    size: 0x400
    initable: true
    filename: "scripts/pydev/flipflop.py"

adc4: Analog.STM32_ADC @ sysbus 0x46021000
    IRQ->nvic0@113

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000

// st,stm32u5 overlay

sysbus:
    init add:
        ApplySVD @https://dl.antmicro.com/projects/renode/svd/STM32U5XX.svd.gz
        Unregister "sysbus.rcc"
        Machine PyDevFromFile @scripts/pydev/flipflop.py 0x46020C1C 0x4 True "RCC_CFGR1"
        Tag <0x46020C00 4> "RCC_CR" 0xFFFFFFFF
        Tag <0x46020CF0 4> "RCC_BDCR" 0xFFFFFFFF
        Tag <0x46020828 4> "PWR_DBPR" 0xFFFFFFFF
        Tag <0x40030404 4> "ICACHE_SR_IDLE" 0x0
